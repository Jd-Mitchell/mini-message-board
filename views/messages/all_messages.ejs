<a href="<%= BASE_URL %>/new">
    <button>Send a message!</button>
</a>

<ul>
    <% messages.forEach((message, index)=> { %>
        <br>
        <li>from: <%= message.user%>
        </li>
        <li>On: <%= message.added.toLocaleString()%>
        </li>
        <br>

        <a href="<%= BASE_URL%>/view_messages/<%= index %>">
            <button>View message</button>           
        </a>
        <% }) %>

</ul>
<a href="<%= BASE_URL %>/new">
    <button>Send a message!</button>
</a>